        <mxCell id="edge-p0-p3" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#667683;strokeWidth=1.8;dashed=1;exitX=1.0;exitY=0.21739130434782608;entryX=0.51;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p0" target="p3">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1520" y="155" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-p0-p3" value="minimum contracts + implementation / test evidence" style="text;html=0;fontSize=14;align=center;fillColor=#ffffff;fontColor=#465966;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1071.5" y="125" width="367.0" height="24" />
        </mxCell>
        <mxCell id="edge-trace-dev" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#667683;strokeWidth=1.8;dashed=1;exitX=1.0;exitY=0.2;entryX=0.27;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p2" target="p3">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="1205" y="380" />
              <mxPoint x="1205" y="285" />
              <mxPoint x="1400" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-trace-dev" value="for developer-path checks" style="text;html=0;fontSize=14;align=center;fillColor=#ffffff;fontColor=#465966;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215.25" y="256" width="189.5" height="24" />
        </mxCell>
        <mxCell id="edge-dev-release" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#667683;strokeWidth=1.8;dashed=1;exitX=0.51;exitY=1.0;entryX=0.51;entryY=0.0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="p3" target="p4">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="label-dev-release" value="implementation / tests for release increment" style="text;html=0;fontSize=14;align=center;fillColor=#ffffff;fontColor=#465966;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1357.8" y="571" width="324.4" height="24" />
        </mxCell>
        <mxCell id="note-0" value="Baseline-to-document work can start from an external baseline&#10;P4's document minimum does not require P1, P2, or automated P3 integrations. The release increment needs the applicable current implementation, verification, validation, risk, labels, and decisions." style="text;whiteSpace=wrap;html=0;align=left;fontSize=15;fontColor=#52616b;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="527" width="1100" height="85" />
        </mxCell>
        <mxCell id="note-1" value="Meaning of connections&#10;Solid = minimum prerequisite for the named workflow. Dashed = another available input path or an increment-specific prerequisite. Domain evidence and feedback apply across packages; boxes do not establish supplier coverage or implementation status." style="text;whiteSpace=wrap;html=0;align=left;fontSize=15;fontColor=#52616b;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="1047" width="1730" height="85" />
        </mxCell>
