        <mxCell id="label-p0-p2" value="minimum contracts + existing records / links" style="text;html=0;fontSize=14;align=center;fillColor=#ffffff;fontColor=#465966;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="747.8" y="193" width="324.4" height="24" />
