  <diagram id="change-loops" name="3. Change review and the learning loop">
    <mxGraphModel dx="1800" dy="1060" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="3. Change review and the learning loop" style="text;html=0;fontSize=25;fontStyle=1;align=left;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="15" width="1730" height="40" />
        </mxCell>
        <mxCell id="subtitle" value="Outer-loop independence and breadth are separate from cadence · learning changes methods through reviewed versions" style="text;html=0;fontSize=16;align=left;fontColor=#52616b;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="55" width="1730" height="35" />
        </mxCell>
        <mxCell id="observe" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Observe a significant&lt;br&gt;change&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;SRC / CODE / RUN / DEFECT&lt;br&gt;J13 → J09&lt;br&gt;Exact old / new references&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#f4f4f2;strokeColor=#71776f;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="155" width="255" height="170" />
        </mxCell>
        <mxCell id="scope-change" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Record scope and impact&lt;br&gt;work&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;CHANGE · J09&lt;br&gt;Prior BASE and relevant links&lt;br&gt;Owners and unresolved&lt;br&gt;questions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="155" width="255" height="170" />
        </mxCell>
        <mxCell id="worker" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Worker drafts, checks,&lt;br&gt;revises&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Inner loop&lt;br&gt;Local rules and relevant&lt;br&gt;evidence&lt;br&gt;Versioned candidate and check&lt;br&gt;results&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="625" y="155" width="255" height="170" />
        </mxCell>
        <mxCell id="independent" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Independent broader check&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Outer loop · per significant&lt;br&gt;change&lt;br&gt;Requirements, hazards,&lt;br&gt;controls&lt;br&gt;Tests, traces, labels,&lt;br&gt;configuration&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="155" width="255" height="170" />
        </mxCell>
        <mxCell id="dispose" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;People disposition&lt;br&gt;findings&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;REVIEW · J09&lt;br&gt;Update / relink / retest /&lt;br&gt;defer&lt;br&gt;Reasons and accountable owners&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1215" y="155" width="255" height="170" />
        </mxCell>
        <mxCell id="new-state" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Review the resulting&lt;br&gt;state&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;J07 / J08 retest or evaluate&lt;br&gt;as needed&lt;br&gt;J10 new BASE; J12 new DOC&lt;br&gt;J11 separate REL decision if&lt;br&gt;relevant&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1510" y="155" width="255" height="170" />
        </mxCell>
        <mxCell id="scope-evidence" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Check the underlying evidence, including missing links&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;J02 / J03 needs and requirements · J04 design/build&lt;br&gt;J05 risk and controls · J06 tasks/UI · J07 tests/results&lt;br&gt;J08 validation · J14 model/data where applicable&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#f4f4f2;strokeColor=#71776f;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="395" width="765" height="125" />
        </mxCell>
        <mxCell id="corrections" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Capture corrections and failures&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;FB · start with the first workflow&lt;br&gt;Reviewer edits, rejections, QA/risk comments&lt;br&gt;Missing traces, failures, rework, redirection&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="615" width="455" height="155" />
        </mxCell>
        <mxCell id="patterns" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Investigate recurring causes&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Meta-loop · J15&lt;br&gt;Daily / weekly / monthly as appropriate&lt;br&gt;Separate product defects from method&lt;br&gt;failures&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="615" width="335" height="155" />
        </mxCell>
        <mxCell id="evaluate" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Propose and evaluate a method change&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;METHOD · J15&lt;br&gt;Prompt, rule, context, tool, or workflow&lt;br&gt;Evaluate failures and previously correct&lt;br&gt;cases&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1065" y="615" width="360" height="155" />
        </mxCell>
        <mxCell id="adopt" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Review and adopt a method&lt;br&gt;version&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;METHOD / REVIEW · J15&lt;br&gt;Record before / after, evidence,&lt;br&gt;owner&lt;br&gt;Observe subsequent corrections&lt;br&gt;and regressions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1490" y="615" width="275" height="175" />
        </mxCell>
        <mxCell id="method-use" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Use adopted methods in future work and checking&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;J01–J14 · versioned drafting instructions, rules, context selection, and independent review methods&lt;br&gt;Retain prior methods and evaluation evidence. Product evidence changes still use their own change process.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="900" width="1220" height="90" />
        </mxCell>
        <mxCell id="edge-top-0" style="edgeStyle=none;html=0;endArrow=block;endFill=1;strokeColor=#667683;strokeWidth=1.8;dashed=0;exitX=1.0;exitY=0.4411764705882353;entryX=0.0;entryY=0.4411764705882353;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="observe" target="scope-change">
