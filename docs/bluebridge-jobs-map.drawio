        <mxCell id="homes" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Provisional homes for controlled records&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Internal BlueBridge, bought tool, or a hybrid&lt;br&gt;Demo candidate: D1 / SQLite structured records&lt;br&gt;R2 file bytes and attachments&lt;br&gt;One authoritative home per controlled record&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
