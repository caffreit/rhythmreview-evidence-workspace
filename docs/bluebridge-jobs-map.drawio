  <diagram id="source-flow" name="2. Source information becomes reviewed, connected evidence">
    <mxGraphModel dx="1500" dy="1190" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1190" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="2. Source information becomes reviewed, connected evidence" style="text;html=0;fontSize=25;fontStyle=1;align=left;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="15" width="1430" height="40" />
        </mxCell>
        <mxCell id="subtitle" value="Capturing a reference does not transfer authority · a finding, a decision, and a baseline are separate records" style="text;html=0;fontSize=16;align=left;fontColor=#52616b;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="55" width="1430" height="35" />
        </mxCell>
        <mxCell id="capture" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Capture an exact source revision&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;SRC · J01 / J13&lt;br&gt;Origin, revision, locator, captured content&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#f4f4f2;strokeColor=#71776f;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="135" width="430" height="100" />
        </mxCell>
        <mxCell id="draft" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Interpret, clarify, and draft candidates&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;NEED / SYS / SUB / LINK · J02 / J03&lt;br&gt;Citations, proposed links, unresolved questions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="315" width="430" height="110" />
        </mxCell>
        <mxCell id="outer" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Independently interrogate the result&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;REVIEW · outer loop&lt;br&gt;Check source meaning, coverage, links, and wider&lt;br&gt;consistency&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="510" width="430" height="110" />
        </mxCell>
        <mxCell id="human" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Review the named candidate and links&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;REVIEW · responsible person&lt;br&gt;Accept, reject, revise, or defer with a reason&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="700" width="430" height="110" />
        </mxCell>
        <mxCell id="baseline" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Save accepted records; review the state&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Stable IDs and versions → BASE · J10&lt;br&gt;Individual acceptance and baseline decision stay&lt;br&gt;distinct&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="900" width="430" height="110" />
        </mxCell>
        <mxCell id="original" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Original information homes&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Slack / meeting system / documents&lt;br&gt;Authoritative for supplied source content&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#f4f4f2;strokeColor=#71776f;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="135" width="335" height="100" />
        </mxCell>
        <mxCell id="clarify" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Clarify with the responsible&lt;br&gt;person&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;CLAR · J02&lt;br&gt;Retain the question, answer, and basis&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="315" width="335" height="110" />
        </mxCell>
        <mxCell id="inner" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Inner loop: check and revise&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Worker / drafting agent&lt;br&gt;Measurability, format, rules, citations&lt;br&gt;Bounded retries; unresolved issues remain&lt;br&gt;visible&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#eff5f9;strokeColor=#41637c;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
