        </mxCell>
        <mxCell id="rework" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Return to the author or&lt;br&gt;clarification&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Record rejected / deferred proposals&lt;br&gt;A revised candidate gets fresh applicable&lt;br&gt;checks&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#faf3e6;strokeColor=#977642;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="35" y="710" width="335" height="130" />
        </mxCell>
        <mxCell id="context" value="&lt;div style=&quot;font-size:16px;font-weight:bold;line-height:19px&quot;&gt;Independent access to underlying evidence&lt;/div&gt;&lt;div style=&quot;margin-top:4px;font-size:14px;line-height:18px&quot;&gt;Sources, existing needs and requirements&lt;br&gt;Risk / usability / model evidence&lt;br&gt;Design, code/build, tests, and configuration&lt;br&gt;Selected for the change; omissions are findings&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;align=left;spacing=12;fillColor=#f4f4f2;strokeColor=#71776f;fontColor=#223746;fontFamily=Arial;" vertex="1" parent="1">
